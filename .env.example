# Copiar a .env (en la raíz del repo) y completar.
# Lo usan el worker, el simulador y el script de usuarios. Nunca la app.

# Supabase Cloud → Project Settings → API:
# URL del proyecto y la "service_role" (o "secret") key.
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Contraseña común de los 4 usuarios de prueba (mín. 6 caracteres; placeholder: elegir la propia)
TEST_USERS_PASSWORD=<password>
