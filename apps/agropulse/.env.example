# Copiar a .env (en esta misma carpeta) y completar.
# Solo valores públicos: la app usa la anon key y RLS. Nunca poner acá la service role / secret key.

# Supabase Cloud → Project Settings → API:
# URL del proyecto y la "anon" (o "publishable") key.
EXPO_PUBLIC_SUPABASE_URL=https://<tu-proyecto>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
